{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/AgentArmor/agents/codex_code/hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking tool call with Kai"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/AgentArmor/agents/codex_code/hook.py\"",
            "timeout": 120,
            "async": true
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/AgentArmor/agents/codex_code/hook.py\"",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/AgentArmor/agents/codex_code/hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
