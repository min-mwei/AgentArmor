# Merge into a trusted project's .codex/config.toml or ~/.codex/config.toml.
# Replace /ABSOLUTE/PATH/agentarmor with the trusted installed executable.
# Native policy evaluation is unqualified: synchronous checks currently deny.
# Install this inline configuration OR hooks.json.example, once.
[features]
hooks = true

[[hooks.PreToolUse]]
matcher = ".*"

[[hooks.PreToolUse.hooks]]
type = "command"
command = '"/ABSOLUTE/PATH/agentarmor" hook --agent codex_code'
timeout = 30
statusMessage = "Checking AgentArmor policy readiness"

[[hooks.PostToolUse]]
matcher = ".*"

[[hooks.PostToolUse.hooks]]
type = "command"
command = '"/ABSOLUTE/PATH/agentarmor" hook --agent codex_code'
timeout = 120
async = true

[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = '"/ABSOLUTE/PATH/agentarmor" hook --agent codex_code'
timeout = 120
async = true

[[hooks.Stop]]

[[hooks.Stop.hooks]]
type = "command"
command = '"/ABSOLUTE/PATH/agentarmor" hook --agent codex_code'
timeout = 30
