# excerpts of real sessions and built pairs are derived: both stay out.
.summarizer/
/train/runs/
/train/data/*
!/train/data/starter/
!/train/data/synthetic/
!/train/data/eval/
models/
checkpoints/
*.safetensors
*.pt
*.bin
*.npy
*.npz

