# Server settings; agentarmor reads .env in the current directory.
ARMOR_HOST=127.0.0.1
ARMOR_PORT=8000
ARMOR_BACKEND=vllm
ARMOR_MODEL=min-h-wei/Kai
ARMOR_SERVED_MODEL_NAME=kai
ARMOR_REVISION=d0d6a5694d0001e06b383f936c9bd8ff77271bf7
# To test through a separately running Kai reference server (e.g. MLX on macOS):
# ARMOR_BACKEND=reference
# ARMOR_REFERENCE_URL=http://127.0.0.1:8009
# ARMOR_API_KEY=replace-with-a-secret
ARMOR_DTYPE=bfloat16
ARMOR_TENSOR_PARALLEL_SIZE=1
ARMOR_GPU_MEMORY_UTILIZATION=0.85
# Optional explicit KV-cache budget. Metal defaults to 512 MiB at an 8K window.
# ARMOR_KV_CACHE_MEMORY_MB=512
ARMOR_MAX_MODEL_LEN=8192
ARMOR_MAX_NUM_SEQS=8
ARMOR_SCAN_CHUNK_CHARS=4000
ARMOR_SCAN_OVERLAP_CHARS=400
ARMOR_SCAN_QUEUE_SIZE=64
ARMOR_SCAN_MAX_JOBS=1024
ARMOR_SCAN_JOB_TTL_SECONDS=3600

# Hook settings are shell environment variables (export before starting the agent).
# AGENTARMOR_URL=http://127.0.0.1:8000
# AGENTARMOR_API_KEY=the-same-secret-as-ARMOR_API_KEY
# AGENTARMOR_POLICY_FILE=/absolute/path/to/operator-policy.json
# AGENTARMOR_TASK=The operator-authorized task for this session
# AGENTARMOR_TIMEOUT=20
